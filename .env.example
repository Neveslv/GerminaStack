DATABASE_URL=postgres://germinastack:replace-with-database-password@localhost:5432/germinastack?sslmode=require
# Gere dois segredos aleatórios independentes, distintos e com pelo menos 32 bytes antes de iniciar.
JWT_SECRET=
TWO_FACTOR_SECRET=

# Obrigatório apenas quando os três GOOGLE_* não forem configurados.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=GerminaStack

COOKIE_SECURE=true
HTTP_ADDR=:8080
# Prazo da autenticação; o WriteTimeout também reserva leitura, invalidação e resposta.
AUTH_OPERATION_TIMEOUT=15s

# Opcional: ativa o assistente @frok. A chave fica apenas no servidor.
GROQ_API_KEY=
FROK_MODEL=openai/gpt-oss-20b
FROK_TIMEOUT=30s
# Opcional: memória persistente do @frok, isolada por usuário. A URI fica apenas no servidor.
FROK_MONGODB_URI=
FROK_MONGODB_DATABASE=germinastack
